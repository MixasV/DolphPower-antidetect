{
  "name": "dolfpower",
  "version": "0.6.0",
  "description": "DolfPower - Free AntiDetect Browser with Extensions, 2FA, IP Checker, Import/Export",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev:server": "ts-node src/server/index.ts",
    "dev:electron": "electron .",
    "build": "tsc && xcopy src\\ui dist\\ui /E /I /Y && xcopy resources dist\\resources /E /I /Y",
    "build:linux": "tsc && cp -r src/ui dist/ui && cp -r resources dist/resources",
    "test": "jest",
    "start": "npm run build && electron .",
    "server": "npm run build && node dist/server/index.js",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build:linux && electron-builder --linux --publish never",
    "dist:mac": "npm run build:linux && electron-builder --mac --publish never"
  },
  "keywords": [
    "antidetect",
    "browser",
    "automation",
    "fingerprint"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.dolfpower.antidetect",
    "productName": "DolfPower",
    "copyright": "Copyright © 2026 DolfPower",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "resources/app_icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DolfPower"
    },
    "portable": {
      "artifactName": "DolfPower-${version}-portable.exe"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "resources/app_icon.png",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "DolfPower-${version}-${arch}.dmg"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb",      "arch": ["x64"] }
      ],
      "icon": "resources/app_icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chrome-remote-interface": "^0.33.0",
    "clipboardy": "^5.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "puppeteer-core": "^21.5.0",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.9.0",
    "@types/uuid": "^9.0.6",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
